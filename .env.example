# ==============================================================================
# Nerve — Solo-Founder Vision-to-Execution OS Configuration
# ==============================================================================

# Local Web App Server (Loopback binding by default)
PORT=3000
HOST=127.0.0.1

# Database Engine
# By default, Nerve uses zero-config embedded PostgreSQL 16 WASM via PGlite:
NERVE_PG_DIR=./nerve-pgdata

# Or connect to an external PostgreSQL instance (uncomment to enable):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nerve
# POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/nerve

# Local Agent Bridge Daemon (runs via `bun run bridge` on port 3031)
NERVE_BRIDGE_PORT=3031
NERVE_BRIDGE_TOKEN=nrv_live_bridge_secret

# CLI Agent Adapter Binary Overrides (optional, auto-detected from PATH by default)
# NERVE_CODEX_BIN=codex
# NERVE_CODEX_MODEL=
# NERVE_AGY_BIN=agy
# NERVE_AGY_MODEL=
# NERVE_OPENCODE_BIN=opencode
# NERVE_OPENCODE_MODEL=
# NERVE_PI_BIN=pi
# NERVE_PI_MODEL=
# NERVE_DROID_BIN=droid
# NERVE_DROID_MODEL=

# Execution Limits & Trust Boundaries
NERVE_AGENT_TIMEOUT_MS=120000
NERVE_AGENT_MAX_OUTPUT=262144
