# Local server (defaults are safe: loopback only)
PORT=3030
HOST=127.0.0.1
# Path to sqlite file. Use :memory: in tests.
NERVE_DB=./nerve.db
# Optional per-adapter overrides (executable path, model, extra safe args as JSON array).
# Examples:
# NERVE_CODEX_BIN=codex
# NERVE_CODEX_MODEL=
# NERVE_AGY_BIN=agy
# NERVE_OPENCODE_BIN=opencode
# NERVE_PI_BIN=pi
# NERVE_DROID_BIN=droid
# Agent safety (do not raise unless you understand the trade-off)
NERVE_AGENT_TIMEOUT_MS=120000
NERVE_AGENT_MAX_OUTPUT=262144
